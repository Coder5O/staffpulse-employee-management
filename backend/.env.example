APP_NAME="StaffPulse"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────
# Default: MySQL (switch to sqlite for lightweight local dev)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=staffpulse
DB_USERNAME=staffpulse
DB_PASSWORD=staffpulse_secret

# ── Cache / Queue / Session ───────────────────────────────────
BROADCAST_CONNECTION=log
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

# ── Mail ──────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@staffpulse.local"
MAIL_FROM_NAME="${APP_NAME}"
